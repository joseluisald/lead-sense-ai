{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM oven/bun:1 AS builder",
    "WORKDIR /app",
    "COPY package.json bun.lockb* ./",
    "RUN bun install",
    "COPY . .",
    "ARG PUBLIC_API_URL",
    "ENV PUBLIC_API_URL=$PUBLIC_API_URL",
    "RUN bun run build",
    "FROM nginx:alpine",
    "COPY --from=builder /app/dist /usr/share/nginx/html",
    "EXPOSE 80"
  ]
}