---
interface Lead {
  id: string;
  name: string;
  email: string;
  score: number;
  probability: 'HIGH' | 'MEDIUM' | 'LOW' | string;
  status: string;
  createdAt: string | Date;
  clientName?: string;
}

interface Trend {
  date: string | Date;
  verified: number;
  unverified: number;
  avgScore: number;
}

const emptyStats = {
  totalLeads: 0,
  verifiedLeads: 0,
  avgScore: 0,
  conversionRate: 0,
  probStats: [
    { name: 'HIGH', value: 0, color: '#22c55e' },
    { name: 'MEDIUM', value: 0, color: '#eab308' },
    { name: 'LOW', value: 0, color: '#ef4444' }
  ],
  dailyTrends: [] as Trend[]
};

const apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
let stats = emptyStats;
let leads: Lead[] = [];
let apiOnline = false;

try {
  const [statsResponse, leadsResponse] = await Promise.all([
    fetch(`${apiBaseUrl}/api/stats`),
    fetch(`${apiBaseUrl}/api/leads`)
  ]);

  if (!statsResponse.ok || !leadsResponse.ok) throw new Error('API unavailable');

  const statsData = await statsResponse.json();
  const leadsData = await leadsResponse.json();

  stats = {
    totalLeads: Number(statsData.totalLeads || 0),
    verifiedLeads: Number(statsData.verifiedLeads || 0),
    avgScore: Number(statsData.avgScore || 0),
    conversionRate: Number(statsData.conversionRate || 0),
    probStats: Array.isArray(statsData.probStats) ? statsData.probStats : emptyStats.probStats,
    dailyTrends: Array.isArray(statsData.dailyTrends) ? statsData.dailyTrends : []
  };
  leads = Array.isArray(leadsData) ? leadsData.slice(0, 5) : [];
  apiOnline = true;
} catch {
  stats = emptyStats;
}

const conversionRate = Math.min(Math.max(stats.conversionRate, 0), 100);
const recentTrend = stats.dailyTrends.slice(-7);
const trendMax = Math.max(...recentTrend.map((day) => Number(day.verified) + Number(day.unverified)), 1);
const trendPoints = recentTrend.map((day, index) => {
  const x = recentTrend.length === 1 ? 50 : (index / (recentTrend.length - 1)) * 100;
  const total = Number(day.verified) + Number(day.unverified);
  const y = 94 - (total / trendMax) * 78;
  return `${x},${y}`;
}).join(' ');

function formatDate(value: string | Date) {
  const date = new Date(String(value));
  if (Number.isNaN(date.getTime())) return 'Data indisponível';
  return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(date);
}

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    verified: 'Verificado',
    pending_verification: 'Pendente',
    rejected: 'Rejeitado'
  };
  return labels[status] || status;
}

function statusClass(status: string) {
  if (status === 'verified') return 'bg-green-500/10 text-green-400';
  if (status === 'rejected') return 'bg-red-500/10 text-red-400';
  return 'bg-amber-500/10 text-amber-400';
}

function probabilityBar(value: number) {
  const ratio = stats.totalLeads > 0 ? value / stats.totalLeads : 0;
  if (ratio >= 0.75) return 'w-full';
  if (ratio >= 0.5) return 'w-3/4';
  if (ratio >= 0.25) return 'w-1/2';
  if (ratio > 0) return 'w-1/4';
  return 'w-0';
}
---

<section class="min-h-full bg-slate-50 px-5 py-6 sm:px-8 lg:px-10">
  <div class="mx-auto max-w-7xl">
    <header class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-green-600">Visão geral</p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Olá, administrador</h1>
        <p class="mt-2 text-slate-500">Acompanhe a qualidade dos seus leads em um só lugar.</p>
      </div>
      <div class="flex items-center gap-3 self-start rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm sm:self-auto">
        <span class:list={["h-2.5 w-2.5 rounded-full", apiOnline ? "bg-green-500" : "bg-red-400"]}></span>
        <span class="text-sm font-medium text-slate-600">API {apiOnline ? 'online' : 'offline'}</span>
      </div>
    </header>

    {!apiOnline && (
      <div class="mb-6 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        <i class="ph ph-info mt-0.5 text-lg"></i>
        <p>Conecte o backend para visualizar dados reais. A estrutura do dashboard está pronta.</p>
      </div>
    )}

    <div class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Total de leads</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">{stats.totalLeads.toLocaleString('pt-BR')}</p>
          </div>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-500/10 text-green-600"><i class="ph ph-users-three text-xl"></i></span>
        </div>
        <p class="mt-4 text-xs text-slate-400">Leads recebidos pela plataforma</p>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Leads verificados</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">{stats.verifiedLeads.toLocaleString('pt-BR')}</p>
          </div>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600"><i class="ph ph-seal-check text-xl"></i></span>
        </div>
        <p class="mt-4 text-xs text-slate-400">Contatos que confirmaram interesse</p>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Score médio</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">{stats.avgScore}<span class="text-lg font-medium text-slate-400">/100</span></p>
          </div>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-500/10 text-violet-600"><i class="ph ph-sparkle text-xl"></i></span>
        </div>
        <p class="mt-4 text-xs text-slate-400">Qualidade média dos contatos</p>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between">
          <div>
            <p class="text-sm font-medium text-slate-500">Taxa de conversão</p>
            <p class="mt-3 text-3xl font-bold text-slate-900">{conversionRate}%</p>
          </div>
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600"><i class="ph ph-trend-up text-xl"></i></span>
        </div>
        <p class="mt-4 text-xs text-slate-400">Leads verificados sobre o total</p>
      </article>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.55fr_1fr]">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Evolução dos leads</h2>
            <p class="mt-1 text-sm text-slate-500">Volume de leads nos últimos dias</p>
          </div>
          <span class="rounded-lg bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700">7 dias</span>
        </div>
        {recentTrend.length > 0 ? (
          <div>
            <div class="relative h-56 overflow-hidden rounded-xl bg-slate-50 px-2 py-3">
              <div class="pointer-events-none absolute inset-x-3 top-6 border-t border-dashed border-slate-200"></div>
              <div class="pointer-events-none absolute inset-x-3 top-1/2 border-t border-dashed border-slate-200"></div>
              <div class="pointer-events-none absolute inset-x-3 bottom-7 border-t border-dashed border-slate-200"></div>
              <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="relative h-full w-full" aria-label="Gráfico de evolução dos leads" role="img">
                <polyline points={trendPoints} fill="none" class="stroke-green-500" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
              </svg>
            </div>
            <div class="mt-3 flex justify-between px-2 text-xs text-slate-400">
              {recentTrend.map((day) => <span>{formatDate(day.date)}</span>)}
            </div>
          </div>
        ) : (
          <div class="flex h-56 items-center justify-center rounded-xl bg-slate-50 text-sm text-slate-400">Ainda não há dados de tendência.</div>
        )}
      </section>

      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="mb-6">
          <h2 class="text-lg font-bold text-slate-900">Qualidade dos leads</h2>
          <p class="mt-1 text-sm text-slate-500">Distribuição por probabilidade</p>
        </div>
        <div class="space-y-5">
          {stats.probStats.map((item) => (
            <div>
              <div class="mb-2 flex items-center justify-between text-sm">
                <span class="flex items-center gap-2 font-medium text-slate-700"><span class:list={["h-2.5 w-2.5 rounded-full", item.name === 'HIGH' ? 'bg-green-500' : item.name === 'MEDIUM' ? 'bg-amber-400' : 'bg-red-400']}></span>{item.name === 'HIGH' ? 'Alta' : item.name === 'MEDIUM' ? 'Média' : 'Baixa'}</span>
                <span class="font-bold text-slate-900">{Number(item.value).toLocaleString('pt-BR')}</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-slate-100"><div class:list={["h-full rounded-full transition-all", item.name === 'HIGH' ? 'bg-green-500' : item.name === 'MEDIUM' ? 'bg-amber-400' : 'bg-red-400', probabilityBar(Number(item.value))]}></div></div>
            </div>
          ))}
        </div>
        <div class="mt-8 rounded-xl bg-slate-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Indicador principal</p>
          <p class="mt-2 text-2xl font-bold text-slate-900">{conversionRate}% <span class="text-sm font-medium text-slate-500">de conversão</span></p>
        </div>
      </section>
    </div>

    <section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col justify-between gap-3 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:px-6">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Leads recentes</h2>
          <p class="mt-1 text-sm text-slate-500">Últimos contatos recebidos pela API</p>
        </div>
        <a href="/leads" class="inline-flex items-center gap-2 text-sm font-semibold text-green-600 transition-colors hover:text-green-700">Ver todos <i class="ph ph-arrow-right"></i></a>
      </div>
      {leads.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full min-w-[680px] text-left">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
              <tr><th class="px-6 py-3 font-semibold">Lead</th><th class="px-6 py-3 font-semibold">Cliente</th><th class="px-6 py-3 font-semibold">Score</th><th class="px-6 py-3 font-semibold">Status</th><th class="px-6 py-3 font-semibold">Recebido em</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {leads.map((lead) => (
                <tr class="transition-colors hover:bg-slate-50">
                  <td class="px-6 py-4"><p class="font-semibold text-slate-800">{lead.name}</p><p class="mt-0.5 text-xs text-slate-400">{lead.email}</p></td>
                  <td class="px-6 py-4 text-sm text-slate-500">{lead.clientName || 'Não informado'}</td>
                  <td class="px-6 py-4"><span class="font-bold text-slate-800">{Number(lead.score)}<span class="font-normal text-slate-400">/100</span></span></td>
                  <td class="px-6 py-4"><span class:list={["rounded-full px-2.5 py-1 text-xs font-semibold", statusClass(lead.status)]}>{statusLabel(lead.status)}</span></td>
                  <td class="px-6 py-4 text-sm text-slate-500">{formatDate(lead.createdAt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center px-6 py-14 text-center"><span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><i class="ph ph-users-three text-2xl"></i></span><h3 class="mt-4 font-semibold text-slate-700">Nenhum lead recente</h3><p class="mt-1 max-w-sm text-sm text-slate-400">Quando novos leads forem recebidos, eles aparecerão nesta lista.</p></div>
      )}
    </section>
  </div>
</section>
