---
import { ArrowLeft, ArrowRight, Check, Leaf, Mail, ShieldCheck } from 'lucide-astro';
import '../styles/global.css';

const apiBaseUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:3000').replace(/\/$/, '');
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Recuperar senha | LeadSense AI</title>
  </head>
  <body class="min-h-screen bg-slate-950 font-sans text-slate-800">
    <main class="flex min-h-screen">
      <section class="relative hidden overflow-hidden bg-slate-900 lg:flex lg:w-1/2 lg:flex-col lg:justify-between lg:p-12 xl:p-16">
        <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>
        <div class="absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-teal-400/10 blur-3xl"></div>

        <a href="/" class="relative z-10 flex items-center gap-3" aria-label="LeadSense AI - página inicial">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 text-slate-950 shadow-lg shadow-cyan-500/20 ring-1 ring-cyan-300/20">
            <Leaf class="text-2xl" aria-hidden="true" />
          </span>
          <span class="text-xl font-bold tracking-tight text-white">LeadSense <span class="text-cyan-400">AI</span></span>
        </a>

        <div class="relative z-10 max-w-lg">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">Acesso seguro</p>
          <h1 class="text-4xl font-bold leading-tight tracking-tight text-white xl:text-5xl">Retome o controle da sua operação.</h1>
          <p class="mt-6 max-w-md text-base leading-7 text-slate-400">Recupere o acesso ao seu painel e continue transformando seus leads em oportunidades reais.</p>
          <div class="mt-10 flex items-center gap-3 text-sm font-medium text-slate-300">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400"><ShieldCheck class="text-lg" aria-hidden="true" /></span>
            Um link seguro será enviado para o seu e-mail
          </div>
        </div>

        <p class="relative z-10 text-sm text-slate-500">© 2025 LeadSense AI. Gestão inteligente de leads.</p>
      </section>

      <section class="flex w-full items-center justify-center bg-slate-50 px-5 py-12 sm:px-8 lg:w-1/2 lg:px-12 xl:px-20">
        <div class="w-full max-w-md">
          <a href="/" class="mb-12 flex items-center justify-center gap-3 lg:hidden" aria-label="LeadSense AI - página inicial">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 text-slate-950 shadow-lg shadow-cyan-500/20 ring-1 ring-cyan-300/20">
              <Leaf class="text-2xl" aria-hidden="true" />
            </span>
            <span class="text-xl font-bold tracking-tight text-slate-900">LeadSense <span class="text-blue-600">AI</span></span>
          </a>

          <a href="/login" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-800">
            <ArrowLeft class="text-base" aria-hidden="true" />
            Voltar para o login
          </a>

          <div class="mb-8">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-100 text-blue-600">
              <Mail class="text-xl" aria-hidden="true" />
            </div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Recuperação de acesso</p>
            <h2 class="text-3xl font-bold tracking-tight text-slate-900">Esqueceu sua senha?</h2>
            <p class="mt-2 leading-6 text-slate-500">Informe o e-mail da sua conta e enviaremos as instruções para criar uma nova senha.</p>
          </div>

          <div x-data={`{
            apiBaseUrl: ${JSON.stringify(apiBaseUrl)},
            email: '',
            submitting: false,
            sent: false,
            error: '',
            async submit() {
              this.error = '';
              this.submitting = true;
              try {
                const response = await fetch(this.apiBaseUrl + '/api/auth/reset-password/request', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email: this.email })
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(data.error || 'Não foi possível enviar as instruções.');
                this.sent = true;
              } catch (error) {
                this.error = error.message;
              } finally {
                this.submitting = false;
              }
            }
          }`}>
            <form @submit.prevent="submit" class="space-y-5">
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-slate-700">E-mail cadastrado</span>
                <input type="email" name="email" x-model="email" placeholder="voce@exemplo.com" autocomplete="email" required class="settings-input h-12 bg-white" />
              </label>

              <p x-show="error" x-cloak class="rounded-xl border border-red-100 bg-red-50 p-4 text-sm leading-5 text-red-700" role="alert" x-text="error"></p>

              <button type="submit" :disabled="submitting" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 disabled:cursor-not-allowed disabled:opacity-60">
                <span x-text="submitting ? 'Enviando...' : 'Enviar instruções'"></span>
                <ArrowRight x-show="!submitting" class="text-lg" aria-hidden="true" />
              </button>
            </form>

            <div x-show="sent" x-cloak class="mt-8 flex items-start gap-3 rounded-xl border border-cyan-100 bg-cyan-50 p-4 text-sm leading-5 text-cyan-800">
              <Check class="mt-0.5 shrink-0 text-base text-blue-600" aria-hidden="true" />
              <p>Se o e-mail estiver cadastrado, você receberá uma mensagem com o próximo passo.</p>
            </div>
          </div>

          <p class="mt-8 text-center text-sm text-slate-500">Ainda não possui uma conta? <a href="/signup" class="font-semibold text-blue-600 transition-colors hover:text-blue-700">Crie sua conta</a></p>
        </div>
      </section>
    </main>
  </body>
</html>
