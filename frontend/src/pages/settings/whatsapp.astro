---
import { Check, CircleAlert, CircleCheck, Info, LoaderCircle } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <div x-data="settingsForm('whatsapp')" class="min-h-full bg-slate-50 px-5 py-6 sm:px-8 lg:px-10">
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Configurações</p>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">WhatsApp</h1>
          <p class="mt-2 text-slate-500">Conecte o canal que será usado para suas notificações automáticas.</p>
        </div>
        <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full" :class="apiOnline ? 'bg-cyan-500' : 'bg-red-400'"></span>
          <span class="text-sm font-medium text-slate-600">API <span x-text="apiOnline ? 'online' : 'offline'"></span></span>
        </div>
      </header>

      <div x-show="loading" x-cloak class="mb-6 flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm text-slate-500 shadow-sm">
        <LoaderCircle class="animate-spin text-lg text-cyan-500" aria-hidden="true" />
        Carregando configurações...
      </div>

      <form @submit.prevent="saveSettings()" class="space-y-6">
        <fieldset :disabled="loading || saving" class="space-y-6">
          <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="flex flex-col justify-between gap-4 border-b border-slate-100 pb-5 sm:flex-row sm:items-start">
              <div>
                <h2 class="text-lg font-bold text-slate-900">Canal de atendimento</h2>
                <p class="mt-1 text-sm text-slate-500">Configure a conexão com seu provedor de WhatsApp.</p>
              </div>
              <label class="inline-flex cursor-pointer items-center gap-3">
                <span class="text-sm font-semibold text-slate-600">Ativar WhatsApp</span>
                <input type="checkbox" x-model="form.enabled" class="peer sr-only" />
                <span class="relative h-6 w-11 rounded-full bg-slate-200 transition-colors peer-checked:bg-cyan-500 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-cyan-400/40 after:absolute after:left-1 after:top-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow-sm after:transition-transform peer-checked:after:translate-x-5"></span>
              </label>
            </div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2">
              <label>
                <span class="mb-2 block text-sm font-semibold text-slate-700">Provedor</span>
                <select x-model="form.provider" class="settings-input">
                  <option value="cloud_api">WhatsApp Cloud API</option>
                  <option value="evolution_api">Evolution API</option>
                  <option value="z-api">Z-API</option>
                </select>
              </label>
              <label>
                <span class="mb-2 block text-sm font-semibold text-slate-700">Número conectado</span>
                <input type="tel" x-model="form.phoneNumber" placeholder="+55 (11) 99999-9999" autocomplete="tel" class="settings-input" />
              </label>
              <label class="sm:col-span-2">
                <span class="mb-2 block text-sm font-semibold text-slate-700">URL da API</span>
                <input type="url" x-model="form.apiUrl" placeholder="https://api.exemplo.com" autocomplete="url" class="settings-input" />
              </label>
              <label>
                <span class="mb-2 block text-sm font-semibold text-slate-700">Token de acesso</span>
                <input type="password" x-model="form.token" placeholder="••••••••••••••••" autocomplete="new-password" class="settings-input" />
              </label>
              <label>
                <span class="mb-2 block text-sm font-semibold text-slate-700">ID da instância</span>
                <input type="text" x-model="form.instanceId" placeholder="minha-instancia" class="settings-input" />
              </label>
            </div>
          </section>

          <section class="rounded-2xl border border-cyan-100 bg-cyan-50/60 p-5 sm:p-6">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-500/10 text-blue-600"><Info class="text-xl" aria-hidden="true" /></span>
              <div>
                <h2 class="font-bold text-cyan-900">Sobre as credenciais</h2>
                <p class="mt-1 text-sm leading-6 text-cyan-800/80">As credenciais são usadas somente pelo backend para enviar mensagens. Nunca compartilhe seu token em canais públicos.</p>
              </div>
            </div>
          </section>
        </fieldset>

        <div class="flex justify-end">
          <button type="submit" :disabled="loading || saving" class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 disabled:cursor-wait disabled:opacity-60">
            <Check class="text-lg" aria-hidden="true" />
            <span x-text="saving ? 'Salvando...' : 'Salvar alterações'"></span>
          </button>
        </div>

        <div x-show="feedback" x-cloak class="flex items-center gap-3 rounded-xl border px-4 py-3 text-sm font-medium" :class="feedbackType === 'success' ? 'border-cyan-200 bg-cyan-50 text-cyan-700' : 'border-red-200 bg-red-50 text-red-700'" role="status">
          <CircleCheck x-show="feedbackType === 'success'" x-cloak class="text-lg" aria-hidden="true" />
          <CircleAlert x-show="feedbackType !== 'success'" x-cloak class="text-lg text-red-600" aria-hidden="true" />
          <span x-text="feedback"></span>
        </div>
      </form>
    </div>
  </div>
</Layout>
