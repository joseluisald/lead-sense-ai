---
import { ArrowUpRight, BadgeAlert, CircleCheck, Hourglass, LoaderCircle, PlugZap, RefreshCw, Search, UsersRound, X } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div x-data="leads" @keydown.escape.window="selectedLead = null" class="min-h-full bg-slate-50 px-5 py-6 sm:px-8 lg:px-10">
    <div class="mx-auto max-w-7xl">
      <header class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Workspace</p>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Gestão de leads</h1>
          <p class="mt-2 text-slate-500">Consulte, filtre e acompanhe todos os contatos recebidos pela API.</p>
        </div>
        <div class="flex items-center gap-3 self-start sm:self-auto">
          <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <span class="h-2.5 w-2.5 rounded-full" :class="apiOnline ? 'bg-cyan-500' : 'bg-red-400'"></span>
            <span class="text-sm font-medium text-slate-600">API <span x-text="apiOnline ? 'online' : 'offline'"></span></span>
          </div>
          <button
            type="button"
            @click="loadLeads()"
            class="inline-flex h-11 items-center gap-2 rounded-xl bg-slate-900 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50"
            :disabled="loading"
            :class="loading ? 'cursor-wait opacity-70' : ''"
          >
            <RefreshCw class="text-lg" :class="loading ? 'animate-spin' : ''" aria-hidden="true" />
            Atualizar
          </button>
        </div>
      </header>

      <section class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumo dos leads">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Total de leads</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="leads.length.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-500/10 text-blue-600"><UsersRound class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Contatos recebidos pela plataforma</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Verificados</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="verifiedCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600"><CircleCheck class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Leads com interesse confirmado</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Pendentes</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="pendingCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600"><Hourglass class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Aguardando validação</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Rejeitados</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="rejectedCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-500/10 text-red-600"><BadgeAlert class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Leads não aprovados</p>
        </article>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 border-b border-slate-100 px-5 py-5 lg:flex-row lg:items-center lg:justify-between lg:px-6">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Todos os leads</h2>
            <p class="mt-1 text-sm text-slate-500"><span x-text="filteredLeads.length">0</span> resultados encontrados</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <label class="relative block sm:min-w-72">
              <span class="sr-only">Buscar leads</span>
              <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-lg text-slate-400" aria-hidden="true" />
              <input
                type="search"
                x-model="searchTerm"
                placeholder="Buscar por nome ou e-mail"
                class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 text-sm text-slate-700 outline-none transition-colors placeholder:text-slate-400 focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20"
              />
            </label>
            <label>
              <span class="sr-only">Filtrar por status</span>
              <select x-model="statusFilter" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-600 outline-none transition-colors focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20 sm:w-44">
                <option value="all">Todos os status</option>
                <option value="verified">Verificados</option>
                <option value="pending_verification">Pendentes</option>
                <option value="rejected">Rejeitados</option>
              </select>
            </label>
            <label>
              <span class="sr-only">Ordenar leads</span>
              <select x-model="sortBy" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-600 outline-none transition-colors focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20 sm:w-40">
                <option value="newest">Mais recentes</option>
                <option value="score">Maior score</option>
              </select>
            </label>
          </div>
        </div>

        <div x-show="loading" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <LoaderCircle class="mb-3 animate-spin text-3xl text-cyan-500" aria-hidden="true" />
          <p class="text-sm font-medium text-slate-600">Carregando leads...</p>
          <p class="mt-1 text-sm text-slate-400">Buscando os dados mais recentes da API.</p>
        </div>

        <div x-show="!loading && !apiOnline" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-red-400"><PlugZap class="text-2xl" aria-hidden="true" /></span>
          <h3 class="mt-4 font-semibold text-slate-700">Não foi possível conectar à API</h3>
          <p class="mt-1 max-w-md text-sm text-slate-400">Verifique o backend e tente atualizar a lista novamente.</p>
          <button type="button" @click="loadLeads()" class="mt-5 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">Tentar novamente</button>
        </div>

        <div x-show="!loading && apiOnline && filteredLeads.length === 0" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><Search class="text-2xl" aria-hidden="true" /></span>
          <h3 class="mt-4 font-semibold text-slate-700">Nenhum lead encontrado</h3>
          <p class="mt-1 max-w-md text-sm text-slate-400">Tente ajustar a busca ou selecionar outro status.</p>
        </div>

        <div x-show="!loading && apiOnline && filteredLeads.length > 0" x-cloak class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
              <tr>
                <th class="px-6 py-3 font-semibold">Lead</th>
                <th class="px-6 py-3 font-semibold">Cliente</th>
                <th class="px-6 py-3 font-semibold">Score</th>
                <th class="px-6 py-3 font-semibold">Status</th>
                <th class="px-6 py-3 font-semibold">Recebido em</th>
                <th class="px-6 py-3 text-right font-semibold">Ação</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <template x-for="lead in filteredLeads" :key="lead.id || lead.email">
                <tr class="transition-colors hover:bg-slate-50">
                  <td class="px-6 py-4">
                    <button type="button" @click="openLead(lead)" class="text-left focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
                      <p class="font-semibold text-slate-800 transition-colors hover:text-blue-600" x-text="lead.name || 'Lead sem nome'"></p>
                      <p class="mt-0.5 text-xs text-slate-400" x-text="lead.email || 'E-mail não informado'"></p>
                    </button>
                  </td>
                  <td class="px-6 py-4 text-sm text-slate-500" x-text="lead.clientName || 'Não informado'"></td>
                  <td class="px-6 py-4"><span class="font-bold" :class="scoreClass(lead.score)" x-text="Number(lead.score || 0)">0</span><span class="font-normal text-slate-400">/100</span></td>
                  <td class="px-6 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold" :class="statusClass(lead.status)" x-text="statusLabel(lead.status)"></span></td>
                  <td class="px-6 py-4 text-sm text-slate-500" x-text="formatDate(lead.createdAt)"></td>
                  <td class="px-6 py-4 text-right"><button type="button" @click="openLead(lead)" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-blue-600 transition-colors hover:bg-cyan-50 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">Detalhes <ArrowUpRight aria-hidden="true" /></button></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div x-show="selectedLead" x-cloak x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-5 backdrop-blur-sm" @click.self="selectedLead = null">
      <article x-show="selectedLead" x-transition.scale class="w-full max-w-lg overflow-hidden rounded-2xl bg-white shadow-2xl">
        <header class="flex items-start justify-between border-b border-slate-100 px-6 py-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-600">Detalhes do lead</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900" x-text="selectedLead ? (selectedLead.name || 'Lead sem nome') : ''"></h2>
          </div>
          <button type="button" @click="selectedLead = null" aria-label="Fechar detalhes" class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-400/50"><X class="text-lg" aria-hidden="true" /></button>
        </header>
        <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">E-mail</p>
            <p class="mt-1 break-words text-sm font-medium text-slate-700" x-text="selectedLead ? (selectedLead.email || 'Não informado') : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Telefone</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedLead ? (selectedLead.phone || 'Não informado') : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Cliente</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedLead ? (selectedLead.clientName || 'Não informado') : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Score</p>
            <p class="mt-1 text-sm font-bold" :class="selectedLead ? scoreClass(selectedLead.score) : 'text-slate-500'" x-text="selectedLead ? `${Number(selectedLead.score || 0)}/100` : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Status</p>
            <span class="mt-2 inline-block rounded-full px-2.5 py-1 text-xs font-semibold" :class="selectedLead ? statusClass(selectedLead.status) : ''" x-text="selectedLead ? statusLabel(selectedLead.status) : ''"></span>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Recebido em</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedLead ? formatDate(selectedLead.createdAt) : ''"></p>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layout>
