---
import { AlertCircle, ArrowRight, Eye, EyeOff, Leaf, ShieldCheck } from 'lucide-astro';
import '../styles/global.css';
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="flex min-h-screen" x-data="login">
    <div class="relative hidden overflow-hidden bg-slate-900 lg:flex lg:w-1/2 lg:flex-col lg:justify-between lg:p-12 xl:p-16">
      <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>
      <div class="absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-teal-400/10 blur-3xl"></div>

      <a href="/" class="relative z-10 flex items-center gap-3" aria-label="LeadSense AI - página inicial">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 text-slate-950 shadow-lg shadow-cyan-500/20 ring-1 ring-cyan-300/20">
              <Leaf class="text-2xl" aria-hidden="true" />
            </span>
        <span class="text-xl font-bold tracking-tight text-white">LeadSense <span class="text-cyan-400">AI</span></span>
      </a>

      <div class="relative z-10 max-w-lg">
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">Inteligência para seus leads</p>
        <h1 class="text-4xl font-bold leading-tight tracking-tight text-white xl:text-5xl">Transforme contatos em oportunidades reais.</h1>
        <p class="mt-6 max-w-md text-base leading-7 text-slate-400">Centralize sua operação, acompanhe cada lead e tome decisões melhores com dados claros.</p>
        <div class="mt-10 flex items-center gap-3 text-sm font-medium text-slate-300">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400"><ShieldCheck class="text-lg" aria-hidden="true" /></span>
          Seus dados protegidos em todos os momentos
        </div>
      </div>

      <p class="relative z-10 text-sm text-slate-500">© 2025 LeadSense AI. Gestão inteligente de leads.</p>
    </div>

    <div class="flex w-full items-center justify-center bg-slate-50 px-5 py-12 sm:px-8 lg:w-1/2 lg:px-12 xl:px-20">
      <div class="w-full max-w-md">
        <a href="/" class="mb-12 flex items-center justify-center gap-3 lg:hidden" aria-label="LeadSense AI - página inicial">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 text-slate-950 shadow-lg shadow-cyan-500/20 ring-1 ring-cyan-300/20">
                <Leaf class="text-2xl" aria-hidden="true" />
              </span>
          <span class="text-xl font-bold tracking-tight text-slate-900">LeadSense <span class="text-blue-600">AI</span></span>
        </a>

        <div class="mb-8">
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Bem-vindo de volta</p>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900">Entre na sua conta</h2>
          <p class="mt-2 text-slate-500">Acesse seu painel para continuar sua operação.</p>
        </div>

        <div x-data="login">
          <form @submit.prevent="submit" class="space-y-5">

            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-slate-700">E-mail</span>
              <input type="email" name="email" x-model="email" placeholder="voce@exemplo.com" autocomplete="email" required class="settings-input h-12 bg-white" />
            </label>

            <label class="block">
              <span class="mb-2 block text-sm font-semibold text-slate-700">Senha</span>
              <span class="relative block">
                  <input :type="passwordVisible ? 'text' : 'password'" name="password" x-model="password" placeholder="Digite sua senha" autocomplete="current-password" required class="settings-input h-12 bg-white pr-12" />
                  <button type="button" @click="passwordVisible = !passwordVisible" :aria-label="passwordVisible ? 'Ocultar senha' : 'Mostrar senha'" class="absolute right-3 top-1/2 flex -translate-y-1/2 items-center justify-center rounded-lg p-1.5 text-slate-400 transition-colors hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
                    <Eye x-show="!passwordVisible" x-cloak class="text-lg" aria-hidden="true" />
                    <EyeOff x-show="passwordVisible" x-cloak class="text-lg" aria-hidden="true" />
                  </button>
                </span>
            </label>

            <div class="flex items-center justify-between gap-4 pt-1">
              <label class="inline-flex items-center gap-2 text-sm text-slate-500">
                <input type="checkbox" name="remember" x-model="remember" class="h-4 w-4 rounded border-slate-300 text-cyan-500 focus:ring-cyan-400" />
                Lembrar de mim
              </label>
              <a href="/forgot-password" class="text-sm font-semibold text-blue-600 transition-colors hover:text-blue-700">Esqueci minha senha</a>
            </div>

            <p x-show="error" x-cloak class="flex items-start gap-2 rounded-xl border border-red-100 bg-red-50 p-4 text-sm leading-5 text-red-700" role="alert">
              <AlertCircle class="mt-0.5 shrink-0 text-base" aria-hidden="true" />
              <span x-text="error"></span>
            </p>

            <button type="submit" :disabled="submitting" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 disabled:cursor-not-allowed disabled:opacity-60">
              <span x-text="submitting ? 'Entrando...' : 'Entrar no painel'"></span>
              <ArrowRight x-show="!submitting" class="text-lg" aria-hidden="true" />
            </button>
          </form>
        </div>

        <p class="mt-8 text-center text-sm text-slate-500">Ainda não possui uma conta? <a href="/signup" class="font-semibold text-blue-600 transition-colors hover:text-blue-700">Crie sua conta</a></p>

        <p class="mt-8 text-center text-sm text-slate-500">Precisa de ajuda? <a href="mailto:suporte@leadsense.ai" class="font-semibold text-blue-600 transition-colors hover:text-blue-700">Fale com o suporte</a></p>
      </div>
    </div>
  </div>
</Layout>
