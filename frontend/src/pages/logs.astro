---
import { Activity, ArrowUpRight, CircleAlert, CircleCheck, Funnel, Gauge, LoaderCircle, PlugZap, RefreshCw, Search, X } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div x-data="logs" @keydown.escape.window="selectedLog = null" class="min-h-full bg-slate-50 px-5 py-6 sm:px-8 lg:px-10">
    <div class="mx-auto max-w-7xl">
      <header class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Sistema</p>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">API Logs</h1>
          <p class="mt-2 text-slate-500">Acompanhe as requisições e respostas da sua API em tempo real.</p>
        </div>
        <div class="flex items-center gap-3 self-start sm:self-auto">
          <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <span class="h-2.5 w-2.5 rounded-full" :class="apiOnline ? 'bg-cyan-500' : 'bg-red-400'"></span>
            <span class="text-sm font-medium text-slate-600">API <span x-text="apiOnline ? 'online' : 'offline'"></span></span>
          </div>
          <button
            type="button"
            @click="loadLogs()"
            class="inline-flex h-11 items-center gap-2 rounded-xl bg-slate-900 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50"
            :disabled="loading"
            :class="loading ? 'cursor-wait opacity-70' : ''"
          >
            <RefreshCw class="text-lg" :class="loading ? 'animate-spin' : ''" aria-hidden="true" />
            Atualizar
          </button>
        </div>
      </header>

      <section class="mb-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Resumo dos logs">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Total de requisições</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="logs.length.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600"><Activity class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Chamadas registradas pela API</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Sucesso</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="successfulCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-500/10 text-blue-600"><CircleCheck class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Respostas entre 200 e 399</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Erros</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="failedCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-500/10 text-red-600"><CircleAlert class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Respostas com status 400 ou superior</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Tempo médio</p>
              <p class="mt-3 text-3xl font-bold text-slate-900"><span x-text="averageDuration">0</span><span class="text-lg font-medium text-slate-400"> ms</span></p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-500/10 text-violet-600"><Gauge class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Latência média das requisições</p>
        </article>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 border-b border-slate-100 px-5 py-5 lg:flex-row lg:items-center lg:justify-between lg:px-6">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Atividade da API</h2>
            <p class="mt-1 text-sm text-slate-500"><span x-text="filteredLogs.length">0</span> registros encontrados</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <label class="relative block sm:min-w-72">
              <span class="sr-only">Buscar nos logs</span>
              <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-lg text-slate-400" aria-hidden="true" />
              <input
                type="search"
                x-model="searchTerm"
                placeholder="Buscar rota, método ou mensagem"
                class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 text-sm text-slate-700 outline-none transition-colors placeholder:text-slate-400 focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20"
              />
            </label>
            <label>
              <span class="sr-only">Filtrar por método</span>
              <select x-model="methodFilter" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-600 outline-none transition-colors focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20 sm:w-36">
                <option value="all">Todos métodos</option>
                <option value="GET">GET</option>
                <option value="POST">POST</option>
                <option value="PUT">PUT</option>
                <option value="PATCH">PATCH</option>
                <option value="DELETE">DELETE</option>
              </select>
            </label>
            <label>
              <span class="sr-only">Filtrar por resultado</span>
              <select x-model="resultFilter" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-600 outline-none transition-colors focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20 sm:w-36">
                <option value="all">Todos resultados</option>
                <option value="success">Sucesso</option>
                <option value="error">Erros</option>
              </select>
            </label>
            <label>
              <span class="sr-only">Ordenar logs</span>
              <select x-model="sortBy" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-600 outline-none transition-colors focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20 sm:w-36">
                <option value="newest">Mais recentes</option>
                <option value="slowest">Mais lentos</option>
              </select>
            </label>
          </div>
        </div>

        <div x-show="loading" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <i data-lucide="loader-circle" class="mb-3 animate-spin text-3xl text-cyan-500" aria-hidden="true"></i>
          <p class="text-sm font-medium text-slate-600">Carregando logs...</p>
          <p class="mt-1 text-sm text-slate-400">Buscando a atividade mais recente da API.</p>
        </div>

        <div x-show="!loading && !apiOnline" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-red-400"><PlugZap class="text-2xl" aria-hidden="true" /></span>
          <h3 class="mt-4 font-semibold text-slate-700">Não foi possível conectar à API</h3>
          <p class="mt-1 max-w-md text-sm text-slate-400">Verifique o backend e tente atualizar os logs novamente.</p>
          <button type="button" @click="loadLogs()" class="mt-5 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">Tentar novamente</button>
        </div>

        <div x-show="!loading && apiOnline && filteredLogs.length === 0" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><Funnel class="text-2xl" aria-hidden="true" /></span>
          <h3 class="mt-4 font-semibold text-slate-700">Nenhum log encontrado</h3>
          <p class="mt-1 max-w-md text-sm text-slate-400">Tente ajustar os filtros para encontrar outros registros.</p>
        </div>

        <div x-show="!loading && apiOnline && filteredLogs.length > 0" x-cloak class="overflow-x-auto">
          <table class="w-full min-w-[900px] text-left">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
              <tr>
                <th class="px-6 py-3 font-semibold">Data e hora</th>
                <th class="px-6 py-3 font-semibold">Método</th>
                <th class="px-6 py-3 font-semibold">Rota</th>
                <th class="px-6 py-3 font-semibold">Status</th>
                <th class="px-6 py-3 font-semibold">Duração</th>
                <th class="px-6 py-3 text-right font-semibold">Ação</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <template x-for="log in filteredLogs" :key="log.id || `${logDate(log)}-${logPath(log)}`">
                <tr class="transition-colors hover:bg-slate-50">
                  <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-500" x-text="formatDate(logDate(log))"></td>
                  <td class="px-6 py-4"><span class="rounded-md px-2 py-1 text-xs font-bold" :class="methodClass(log)" x-text="logMethod(log)"></span></td>
                  <td class="px-6 py-4"><button type="button" @click="openLog(log)" class="max-w-sm truncate text-left font-mono text-sm font-medium text-slate-700 transition-colors hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-cyan-400/50" x-text="logPath(log)"></button></td>
                  <td class="px-6 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold" :class="statusClass(log)" x-text="logStatusCode(log) || statusLabel(log)"></span></td>
                  <td class="px-6 py-4 text-sm text-slate-500"><span x-text="logDuration(log)">0</span> ms</td>
                  <td class="px-6 py-4 text-right"><button type="button" @click="openLog(log)" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-blue-600 transition-colors hover:bg-cyan-50 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">Detalhes <ArrowUpRight aria-hidden="true" /></button></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div x-show="selectedLog" x-cloak x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-5 backdrop-blur-sm" @click.self="selectedLog = null">
      <article x-show="selectedLog" x-transition.scale class="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl">
        <header class="flex items-start justify-between border-b border-slate-100 px-6 py-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-600">Detalhes da requisição</p>
            <h2 class="mt-1 break-all font-mono text-lg font-bold text-slate-900" x-text="selectedLog ? logPath(selectedLog) : ''"></h2>
          </div>
          <button type="button" @click="selectedLog = null" aria-label="Fechar detalhes" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-400/50"><X class="text-lg" aria-hidden="true" /></button>
        </header>
        <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Método</p>
            <p class="mt-1 font-mono text-sm font-bold text-slate-700" x-text="selectedLog ? logMethod(selectedLog) : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Status</p>
            <p class="mt-1 text-sm font-bold text-slate-700" x-text="selectedLog ? (logStatusCode(selectedLog) || statusLabel(selectedLog)) : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Data e hora</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedLog ? formatDate(logDate(selectedLog)) : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Duração</p>
            <p class="mt-1 text-sm font-medium text-slate-700"><span x-text="selectedLog ? logDuration(selectedLog) : '0'">0</span> ms</p>
          </div>
          <div class="sm:col-span-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Mensagem</p>
            <p class="mt-1 break-words text-sm font-medium text-slate-700" x-text="selectedLog ? (selectedLog.message || 'Nenhuma mensagem registrada') : ''"></p>
          </div>
          <div class="sm:col-span-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Endereço de origem</p>
            <p class="mt-1 break-all font-mono text-sm font-medium text-slate-700" x-text="selectedLog ? (selectedLog.ip || selectedLog.userAgent || 'Não informado') : ''"></p>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layout>
