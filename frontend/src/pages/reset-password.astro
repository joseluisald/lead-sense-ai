---
import { AlertCircle, ArrowLeft, ArrowRight, Check, Eye, EyeOff, KeyRound, Leaf, ShieldCheck } from 'lucide-astro';
import '../styles/global.css';

const apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nova senha | LeadSense AI</title>
  </head>
  <body class="min-h-screen bg-slate-950 font-sans text-slate-800">
    <main class="flex min-h-screen">
      <section class="relative hidden overflow-hidden bg-slate-900 lg:flex lg:w-1/2 lg:flex-col lg:justify-between lg:p-12 xl:p-16">
        <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>
        <div class="absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-teal-400/10 blur-3xl"></div>

        <a href="/" class="relative z-10 flex items-center gap-3" aria-label="LeadSense AI - página inicial">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 text-slate-950 shadow-lg shadow-cyan-500/20 ring-1 ring-cyan-300/20">
            <Leaf class="text-2xl" aria-hidden="true" />
          </span>
          <span class="text-xl font-bold tracking-tight text-white">LeadSense <span class="text-cyan-400">AI</span></span>
        </a>

        <div class="relative z-10 max-w-lg">
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-400">Acesso seguro</p>
          <h1 class="text-4xl font-bold leading-tight tracking-tight text-white xl:text-5xl">Uma nova senha para continuar evoluindo.</h1>
          <p class="mt-6 max-w-md text-base leading-7 text-slate-400">Escolha uma senha forte e volte a acompanhar sua operação com tranquilidade.</p>
          <div class="mt-10 flex items-center gap-3 text-sm font-medium text-slate-300">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-400"><ShieldCheck class="text-lg" aria-hidden="true" /></span>
            Seu acesso protegido em todos os momentos
          </div>
        </div>

        <p class="relative z-10 text-sm text-slate-500">© 2025 LeadSense AI. Gestão inteligente de leads.</p>
      </section>

      <section class="flex w-full items-center justify-center bg-slate-50 px-5 py-12 sm:px-8 lg:w-1/2 lg:px-12 xl:px-20">
        <div class="w-full max-w-md">
          <a href="/login" class="mb-8 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-slate-800">
            <ArrowLeft class="text-base" aria-hidden="true" />
            Voltar para o login
          </a>

          <div class="mb-8">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-100 text-blue-600">
              <KeyRound class="text-xl" aria-hidden="true" />
            </div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Recuperação de acesso</p>
            <h2 class="text-3xl font-bold tracking-tight text-slate-900">Crie uma nova senha</h2>
            <p class="mt-2 leading-6 text-slate-500">Digite uma nova senha para recuperar o acesso à sua conta.</p>
          </div>

          <div x-data={`{
            apiBaseUrl: ${JSON.stringify(apiBaseUrl)},
            token: '',
            password: '',
            passwordConfirmation: '',
            passwordVisible: false,
            confirmationVisible: false,
            submitting: false,
            success: false,
            error: '',
            init() {
              this.token = new URLSearchParams(window.location.search).get('token') || '';
              if (!this.token) this.error = 'O link de redefinição é inválido ou está incompleto.';
            },
            async submit() {
              this.error = '';
              if (this.password !== this.passwordConfirmation) {
                this.error = 'As senhas não conferem.';
                return;
              }
              this.submitting = true;
              try {
                const response = await fetch(this.apiBaseUrl + '/api/auth/reset-password', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ token: this.token, password: this.password })
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(data.error || 'Não foi possível redefinir sua senha.');
                this.success = true;
              } catch (error) {
                this.error = error.message;
              } finally {
                this.submitting = false;
              }
            }
          }`} x-init="init()">
            <form x-show="!success && token" @submit.prevent="submit" class="space-y-5">
              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-slate-700">Nova senha</span>
                <span class="relative block">
                  <input :type="passwordVisible ? 'text' : 'password'" x-model="password" name="password" placeholder="Digite sua nova senha" autocomplete="new-password" minlength="8" required class="settings-input h-12 bg-white pr-12" />
                  <button type="button" @click="passwordVisible = !passwordVisible" :aria-label="passwordVisible ? 'Ocultar senha' : 'Mostrar senha'" class="absolute right-3 top-1/2 flex -translate-y-1/2 items-center justify-center rounded-lg p-1.5 text-slate-400 transition-colors hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
                    <Eye x-show="!passwordVisible" x-cloak class="text-lg" aria-hidden="true" />
                    <EyeOff x-show="passwordVisible" x-cloak class="text-lg" aria-hidden="true" />
                  </button>
                </span>
                <span class="mt-2 block text-xs text-slate-400">Use pelo menos 8 caracteres.</span>
              </label>

              <label class="block">
                <span class="mb-2 block text-sm font-semibold text-slate-700">Confirmar nova senha</span>
                <span class="relative block">
                  <input :type="confirmationVisible ? 'text' : 'password'" x-model="passwordConfirmation" name="password_confirmation" placeholder="Repita sua nova senha" autocomplete="new-password" minlength="8" required class="settings-input h-12 bg-white pr-12" />
                  <button type="button" @click="confirmationVisible = !confirmationVisible" :aria-label="confirmationVisible ? 'Ocultar confirmação' : 'Mostrar confirmação'" class="absolute right-3 top-1/2 flex -translate-y-1/2 items-center justify-center rounded-lg p-1.5 text-slate-400 transition-colors hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
                    <Eye x-show="!confirmationVisible" x-cloak class="text-lg" aria-hidden="true" />
                    <EyeOff x-show="confirmationVisible" x-cloak class="text-lg" aria-hidden="true" />
                  </button>
                </span>
              </label>

              <p x-show="error" x-cloak class="flex items-start gap-2 rounded-xl border border-red-100 bg-red-50 p-4 text-sm leading-5 text-red-700" role="alert">
                <AlertCircle class="mt-0.5 shrink-0 text-base" aria-hidden="true" />
                <span x-text="error"></span>
              </p>

              <button type="submit" :disabled="submitting" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 disabled:cursor-not-allowed disabled:opacity-60">
                <span x-text="submitting ? 'Salvando...' : 'Salvar nova senha'"></span>
                <ArrowRight x-show="!submitting" class="text-lg" aria-hidden="true" />
              </button>
            </form>

            <div x-show="!success && !token" x-cloak class="flex items-start gap-3 rounded-xl border border-red-100 bg-red-50 p-4 text-sm leading-5 text-red-700" role="alert">
              <AlertCircle class="mt-0.5 shrink-0 text-base" aria-hidden="true" />
              <p>Solicite um novo link de recuperação para criar sua senha.</p>
            </div>

            <div x-show="success" x-cloak class="rounded-xl border border-cyan-100 bg-cyan-50 p-5 text-center">
              <span class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-cyan-100 text-blue-600"><Check class="text-xl" aria-hidden="true" /></span>
              <h3 class="font-semibold text-slate-900">Senha alterada com sucesso</h3>
              <p class="mt-2 text-sm leading-5 text-slate-600">Agora você já pode entrar usando sua nova senha.</p>
              <a href="/login" class="mt-5 inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 text-sm font-semibold text-white transition-colors hover:bg-slate-800">Ir para o login <ArrowRight class="text-base" aria-hidden="true" /></a>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
