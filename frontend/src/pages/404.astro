---
import { House, UsersRound } from 'lucide-astro';
import Layout from '../layouts/EmptyLayout.astro';
---

<Layout>
  <div class="flex min-h-full items-center justify-center bg-slate-50 px-5 py-12 sm:px-8">
    <section class="w-full max-w-xl text-center">
      <div class="relative mx-auto flex h-40 w-40 items-center justify-center rounded-[2.5rem] bg-slate-900 shadow-2xl shadow-slate-900/20">
        <span class="absolute -right-3 -top-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-green-500 text-2xl font-bold text-slate-950 shadow-lg shadow-green-500/30">?</span>
        <span class="text-7xl font-black tracking-tighter text-white">404</span>
      </div>

      <p class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-green-600">Página não encontrada</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Este caminho não existe</h1>
      <p class="mx-auto mt-4 max-w-md text-base leading-7 text-slate-500">A página que você tentou acessar pode ter sido movida, removida ou o endereço pode estar incorreto.</p>

      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/dashboard" class="inline-flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-green-400/50">
          <House class="text-lg" aria-hidden="true" />
          Ir para o dashboard
        </a>
        <a href="/leads" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-green-400/50">
          <UsersRound class="text-lg" aria-hidden="true" />
          Ver meus leads
        </a>
      </div>
    </section>
  </div>
</Layout>
