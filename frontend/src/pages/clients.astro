---
import { ArrowUpRight, BadgeAlert, Building2, ChartLine, CircleCheck, Hourglass, LoaderCircle, PlugZap, RefreshCw, Search, X } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div x-data="clients" @keydown.escape.window="selectedClient = null" class="min-h-full bg-slate-50 px-5 py-6 sm:px-8 lg:px-10">
    <div class="mx-auto max-w-7xl">
      <header class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">Workspace</p>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Meus clientes</h1>
          <p class="mt-2 text-slate-500">Gerencie os clientes conectados à sua operação de leads.</p>
        </div>
        <div class="flex items-center gap-3 self-start sm:self-auto">
          <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <span class="h-2.5 w-2.5 rounded-full" :class="apiOnline ? 'bg-cyan-500' : 'bg-red-400'"></span>
            <span class="text-sm font-medium text-slate-600">API <span x-text="apiOnline ? 'online' : 'offline'"></span></span>
          </div>
          <button
            type="button"
            @click="loadClients()"
            class="inline-flex h-11 items-center gap-2 rounded-xl bg-slate-900 px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50"
            :disabled="loading"
            :class="loading ? 'cursor-wait opacity-70' : ''"
          >
            <RefreshCw class="text-lg" :class="loading ? 'animate-spin' : ''" aria-hidden="true" />
            Atualizar
          </button>
        </div>
      </header>

      <section class="mb-8 grid gap-4 sm:grid-cols-3" aria-label="Resumo dos clientes">
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Total de clientes</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="clients.length.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-500/10 text-blue-600"><Building2 class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Contas cadastradas na plataforma</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Clientes ativos</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="activeCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600"><CircleCheck class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Contas disponíveis para receber leads</p>
        </article>

        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Leads processados</p>
              <p class="mt-3 text-3xl font-bold text-slate-900" x-text="leadsCount.toLocaleString('pt-BR')">0</p>
            </div>
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-500/10 text-violet-600"><ChartLine class="text-xl" aria-hidden="true" /></span>
          </div>
          <p class="mt-4 text-xs text-slate-400">Leads associados aos clientes</p>
        </article>
      </section>

      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 border-b border-slate-100 px-5 py-5 lg:flex-row lg:items-center lg:justify-between lg:px-6">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Clientes cadastrados</h2>
            <p class="mt-1 text-sm text-slate-500"><span x-text="filteredClients.length">0</span> resultados encontrados</p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <label class="relative block sm:min-w-80">
              <span class="sr-only">Buscar clientes</span>
              <Search class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-lg text-slate-400" aria-hidden="true" />
              <input
                type="search"
                x-model="searchTerm"
                placeholder="Buscar por nome, empresa ou e-mail"
                class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-4 text-sm text-slate-700 outline-none transition-colors placeholder:text-slate-400 focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20"
              />
            </label>
            <label>
              <span class="sr-only">Ordenar clientes</span>
              <select x-model="sortBy" class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-medium text-slate-600 outline-none transition-colors focus:border-cyan-400 focus:bg-white focus:ring-2 focus:ring-cyan-400/20 sm:w-40">
                <option value="newest">Mais recentes</option>
                <option value="name">Ordem alfabética</option>
              </select>
            </label>
          </div>
        </div>

        <div x-show="loading" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <LoaderCircle class="mb-3 animate-spin text-3xl text-cyan-500" aria-hidden="true" />
          <p class="text-sm font-medium text-slate-600">Carregando clientes...</p>
          <p class="mt-1 text-sm text-slate-400">Buscando os dados mais recentes da API.</p>
        </div>

        <div x-show="!loading && !apiOnline" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-red-400"><PlugZap class="text-2xl" aria-hidden="true" /></span>
          <h3 class="mt-4 font-semibold text-slate-700">Não foi possível conectar à API</h3>
          <p class="mt-1 max-w-md text-sm text-slate-400">Verifique o backend e tente atualizar a lista novamente.</p>
          <button type="button" @click="loadClients()" class="mt-5 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">Tentar novamente</button>
        </div>

        <div x-show="!loading && apiOnline && filteredClients.length === 0" x-cloak class="flex flex-col items-center justify-center px-6 py-20 text-center">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400"><Search class="text-2xl" aria-hidden="true" /></span>
          <h3 class="mt-4 font-semibold text-slate-700">Nenhum cliente encontrado</h3>
          <p class="mt-1 max-w-md text-sm text-slate-400">Tente ajustar a busca para encontrar outra conta.</p>
        </div>

        <div x-show="!loading && apiOnline && filteredClients.length > 0" x-cloak class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
              <tr>
                <th class="px-6 py-3 font-semibold">Cliente</th>
                <th class="px-6 py-3 font-semibold">Contato</th>
                <th class="px-6 py-3 font-semibold">Leads</th>
                <th class="px-6 py-3 font-semibold">Status</th>
                <th class="px-6 py-3 font-semibold">Cadastro</th>
                <th class="px-6 py-3 text-right font-semibold">Ação</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <template x-for="client in filteredClients" :key="client.id || client.email || client.name">
                <tr class="transition-colors hover:bg-slate-50">
                  <td class="px-6 py-4">
                    <button type="button" @click="openClient(client)" class="text-left focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
                      <p class="font-semibold text-slate-800 transition-colors hover:text-blue-600" x-text="clientName(client)"></p>
                      <p class="mt-0.5 text-xs text-slate-400" x-text="client.company || client.email || 'Conta LeadSense'"></p>
                    </button>
                  </td>
                  <td class="px-6 py-4">
                    <p class="text-sm text-slate-600" x-text="client.email || 'E-mail não informado'"></p>
                    <p class="mt-0.5 text-xs text-slate-400" x-text="client.phone || 'Telefone não informado'"></p>
                  </td>
                  <td class="px-6 py-4 text-sm font-semibold text-slate-700" x-text="clientLeadCount(client).toLocaleString('pt-BR')">0</td>
                  <td class="px-6 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold" :class="statusClass(clientStatus(client))" x-text="statusLabel(clientStatus(client))"></span></td>
                  <td class="px-6 py-4 text-sm text-slate-500" x-text="formatDate(client.createdAt)"></td>
                  <td class="px-6 py-4 text-right"><button type="button" @click="openClient(client)" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-blue-600 transition-colors hover:bg-cyan-50 focus:outline-none focus:ring-2 focus:ring-cyan-400/50">Detalhes <ArrowUpRight aria-hidden="true" /></button></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <div x-show="selectedClient" x-cloak x-transition.opacity class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/50 p-5 backdrop-blur-sm" @click.self="selectedClient = null">
      <article x-show="selectedClient" x-transition.scale class="w-full max-w-lg overflow-hidden rounded-2xl bg-white shadow-2xl">
        <header class="flex items-start justify-between border-b border-slate-100 px-6 py-5">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-600">Detalhes do cliente</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900" x-text="selectedClient ? clientName(selectedClient) : ''"></h2>
          </div>
          <button type="button" @click="selectedClient = null" aria-label="Fechar detalhes" class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-400/50"><X class="text-lg" aria-hidden="true" /></button>
        </header>
        <div class="grid gap-5 px-6 py-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">E-mail</p>
            <p class="mt-1 break-words text-sm font-medium text-slate-700" x-text="selectedClient ? (selectedClient.email || 'Não informado') : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Telefone</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedClient ? (selectedClient.phone || 'Não informado') : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Empresa</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedClient ? (selectedClient.company || 'Não informado') : ''"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Leads associados</p>
            <p class="mt-1 text-sm font-bold text-slate-700" x-text="selectedClient ? clientLeadCount(selectedClient).toLocaleString('pt-BR') : '0'"></p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Status</p>
            <span class="mt-2 inline-block rounded-full px-2.5 py-1 text-xs font-semibold" :class="selectedClient ? statusClass(clientStatus(selectedClient)) : ''" x-text="selectedClient ? statusLabel(clientStatus(selectedClient)) : ''"></span>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Data de cadastro</p>
            <p class="mt-1 text-sm font-medium text-slate-700" x-text="selectedClient ? formatDate(selectedClient.createdAt) : ''"></p>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layout>
